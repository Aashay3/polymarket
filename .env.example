# ──────────────────────────────────────────────────────────────
# NEXORA — environment template
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it's in .gitignore.
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# Postgres connection string. Use Neon (https://neon.tech) for hosted.
# For local dev: postgres://postgres:postgres@localhost:5432/nexora
DATABASE_URL=

# ─── Auth.js (NextAuth v5) ────────────────────────────────────
# Generate: `openssl rand -base64 32`
AUTH_SECRET=
# Canonical URL (set to http://localhost:3000 in dev, full domain in prod)
AUTH_URL=http://localhost:3000

# ─── OAuth providers (optional at first) ──────────────────────
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# ─── Blockchain / Web3 ────────────────────────────────────────
# Polygon Amoy testnet by default. Flip to mainnet ONLY after audit.
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology
# WalletConnect Cloud projectId (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses — filled in post-deploy (Phase 6).
# Leave blank during Phases 1-5; read from chain once deployed.
NEXT_PUBLIC_FPMM_FACTORY_ADDRESS=
NEXT_PUBLIC_RESOLVER_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# ─── On-chain settlement (Tier 2 hybrid mode) ─────────────────
# When true, /api/admin/markets and .../resolve mirror the action on
# the deployed PredictionMarket contract. DB stays the source of truth;
# the chain call provides on-chain provenance for the market lifecycle.
# Off when blank/unset — DB-only mode.
ENABLE_ON_CHAIN_SETTLEMENT=false
# Contract address printed by `forge script script/Deploy.s.sol`.
NEXT_PUBLIC_PREDICTION_MARKET_ADDRESS=
# Hot key for admin actions (createMarket, resolve). Demo only — for
# production use a multisig + relayer (Defender/Gelato) instead.
ADMIN_PRIVATE_KEY=

# ─── Deposit / withdrawal (Phase 5) ───────────────────────────
# The wallet address that receives user USDC deposits. Users send USDC
# here; the server verifies the tx on-chain before crediting their
# platform balance. Use a cold multisig in production.
DEPOSIT_ADDRESS=
# USDC token contract on the same chain as NEXT_PUBLIC_CHAIN_ID.
# Polygon mainnet USDC:   0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
# Polygon Amoy USDC test: 0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
USDC_CONTRACT_ADDRESS=
# How many block confirmations before a deposit is credited.
MIN_CONFIRMATIONS=12
# Minimum withdrawal size in USDC (gas-economic floor).
MIN_WITHDRAWAL_USDC=5

# ─── Redis (BullMQ queues, rate limiting) ─────────────────────
# Upstash serverless Redis — https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Observability ────────────────────────────────────────────
# SENTRY_DSN=

# ─── Admin bootstrap (used on first seed only) ────────────────
# Email of the initial admin user — will be granted ADMIN role on seed.
SEED_ADMIN_EMAIL=

# ─── Cron / background ────────────────────────────────────────
# Shared secret for HTTP-triggered crons. The in-process scheduler
# (src/instrumentation.ts) doesn't need this — it runs automatically.
# Only required if you call /api/cron/* externally (e.g., Vercel Cron).
CRON_SECRET=

# ─── Operational safety (Phase 8) ─────────────────────────────
# Hard cap on USDC a single user can withdraw per rolling 24h window.
# Blast-radius control for compromised accounts. Default 50000.
DAILY_WITHDRAWAL_CAP_USDC=50000

# Kill switch. When truthy, the app refuses all trades/deposits/
# withdrawals with a 503 MAINTENANCE_MODE error. Reads still work.
# Use during incident response.
MAINTENANCE_MODE=false

# App version, shown in /api/health output. Use your CI's git sha.
APP_VERSION=dev
